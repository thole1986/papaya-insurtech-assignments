# Explicit offline demo by default. Switch to live for actual Gemini API calls.
RUN_MODE=offline
GOOGLE_API_KEY=
# Required in live mode; choose an available Gemini tool-calling model.
LLM_MODEL=
DATABASE_URL=sqlite+aiosqlite:///./runtime/claims.db
ASSESSMENT_TIMEOUT_SECONDS=180
PROVIDER_TIMEOUT_SECONDS=30
